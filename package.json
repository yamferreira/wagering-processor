{
  "name": "wagering-processor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": "1.3.14"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "^3.1162.0",
    "@mikro-orm/core": "^7.2.7",
    "@mikro-orm/migrations": "^7.2.7",
    "@mikro-orm/postgresql": "^7.2.7",
    "@nestjs/common": "^12.3.3",
    "@nestjs/core": "^12.3.3",
    "@nestjs/platform-express": "^12.3.3",
    "express": "5",
    "pino": "^10.4.0",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/express": "^5.0.6",
    "typescript": "^7.0.2"
  },
  "scripts": {
    "start": "bun run src/main.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "bun test --timeout 60000",
    "test:unit": "bun test test/unit",
    "test:integration": "bun test --timeout 60000 test/integration",
    "test:concurrency": "bun test --timeout 180000 --path-ignore-patterns=__none__ test/concurrency",
    "migration:up": "bun run scripts/migrate.ts up",
    "migration:down": "bun run scripts/migrate.ts down",
    "sqs:setup": "bun run scripts/setup-queues.ts",
    "test:all": "bun run test && bun run test:concurrency",
    "sqs:send": "bun run scripts/send-message.ts",
    "test:load": "bun run test/load/load.ts"
  }
}
