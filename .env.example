# HTTP
PORT=3000

# PostgreSQL (docker compose exposes 55432 on the host)
# Runtime: least-privilege role created by the migrations (no superuser, owns nothing, ledger SELECT/INSERT only)
DATABASE_URL=postgres://wagering_app:wagering_app@localhost:55432/wagering
# Migrations only: schema owner
MIGRATION_DATABASE_URL=postgres://wagering:wagering@localhost:55432/wagering
DB_POOL_MAX=20
DB_LOCK_TIMEOUT_MS=5000
DB_STATEMENT_TIMEOUT_MS=10000

# SQS (LocalStack)
SQS_ENDPOINT=http://localhost:4566
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# Domain
SUPPORTED_CURRENCIES=BRL,USD,EUR

# Logging
LOG_LEVEL=info
